#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_USER         5
#endif

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
			    // buttons
			    &BCK_FWD                  &mkp RCLK
			    &mkp MCLK                 &ltmkp LAYER_SNIPE ENTER
			    &mkp LCLK                 &CPY_PST
			    &lt LAYER_SCROLL ESC      &ltm LAYER_DEVICE ESC

			    // rotary encoders
			    &kp C_VOL_UP              &kp LC(TAB)
			    &kp C_VOL_DN              &kp LC(LS(TAB))
		    >;
		};

		layer1 {
			display-name = "Extras";
			DECLARE_ENCODERS;
			bindings = <
			    &bst_copy      &bst_paste
			    &bst_cut       &bst_undo
			    &bst_undo      &bst_copy
			    &trans         &bst_paste

			    &kp C_VOL_UP   &kp LG(TAB)
			    &kp C_VOL_DN   &kp LG(LS(TAB))
	   		>;
		};

		layer2 {
			display-name = "Device";
			DECLARE_ENCODERS;
			bindings = <
			    &mui_or_dgl          &bt BT_CLR
			    &bst_tog ZBS_TOG     &bt BT_NXT
			    &af_toggle AF_TOG    &bt BT_PRV
			    &studio_unlock       &trans

			    &kp C_VOL_UP         &kp LG(TAB)
			    &kp C_VOL_DN         &kp LG(LS(TAB))
		   	>;
		};

		layer3 {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    &trans              &trans
			    &trans              &trans
			    &rrl 1              &trans
			    &trans              &trans

			    &sens_nowrap P2SM_DEC 1    &scrlsens_nowrap P2SM_INC 1
			    &sens_nowrap P2SM_INC 1    &scrlsens_nowrap P2SM_DEC 1
		  	>;
		};

		layer4 {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
			    &trans           &soft_off
			    &trans           &trans
			    &trans           &trans
			    &trans           &trans

			    &kp LEFT         &kp RIGHT
			    &kp RIGHT        &kp LEFT
	   		>;
		};

		layer5 {
			display-name = "User";
			DECLARE_ENCODERS;
			bindings = <
				&trans        &trans
				&trans        &trans
				&trans        &trans
				&trans        &trans

				&kp C_VOL_UP  &kp LG(TAB)
				&kp C_VOL_DN  &kp LG(LS(TAB))
		    >;
		};
	};

	behaviors {
		CPY_PST: tap-dance-2 {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Back/Forward (tap/double-tap)";
			#binding-cells = <0>;
			tapping-term-ms = <300>;
			bindings = <&kp LG(C)>, <&kp LG(V)>;
		};
		BCK_FWD: tap-dance-1 {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Back/Forward (tap/double-tap)";
			#binding-cells = <0>;
			tapping-term-ms = <300>;
			bindings = <&mkp MB4>, <&mkp MB5>;
		};
	};

	trackball {
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
						   <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
		                   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};
